diff --git a/src/routes/transfers.ts b/src/routes/transfers.ts
--- a/src/routes/transfers.ts
+++ b/src/routes/transfers.ts
@@ -1,5 +1,16 @@
 import { Router } from "express";
 import { requireUser } from "../auth";
+import { ledger } from "../ledger";
 
 export const transfers = Router();
 transfers.use(requireUser);
+
+transfers.post("/transfers", async (req, res, next) => {
+  try {
+    const amount = Number(req.body.amount);
+    const tx = await ledger.transfer(req.user.id, req.body.to, amount);
+    res.status(201).json(tx);
+  } catch (err) {
+    next(err);
+  }
+});
