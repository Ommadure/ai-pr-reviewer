new file mode 100644
--- /dev/null
+++ b/app/rates/client.py
@@ -0,0 +1,24 @@
+import logging
+from decimal import Decimal
+
+import httpx
+
+log = logging.getLogger(__name__)
+RATES_URL = "https://rates.internal/api/v1/rates"
+
+
+class RatesUnavailable(Exception):
+    pass
+
+
+async def fetch_rate(client: httpx.AsyncClient, base: str, quote: str) -> Decimal:
+    """Exchange rate base->quote, or RatesUnavailable if the service can't answer."""
+    try:
+        response = await client.get(
+            RATES_URL, params={"base": base, "quote": quote}, timeout=5.0
+        )
+        response.raise_for_status()
+    except httpx.HTTPError as exc:
+        log.warning("rates service failed for %s/%s: %s", base, quote, exc)
+        raise RatesUnavailable(f"{base}/{quote}") from exc
+    return Decimal(str(response.json()["rate"]))
