+
+
+def search_products(term: str, limit: int = 20):
+    """Products whose name contains `term`, for the storefront search box."""
+    with get_connection() as conn:
+        cur = conn.cursor()
+        cur.execute(
+            f"SELECT id, name, price FROM products WHERE name ILIKE '%{term}%' LIMIT {limit}"
+        )
+        return cur.fetchall()
