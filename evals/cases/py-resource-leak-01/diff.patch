 import sqlite3
 
 DB_PATH = "/var/lib/app/audit.db"
+
+
+def record(event: str, user_id: int) -> None:
+    conn = sqlite3.connect(DB_PATH)
+    conn.execute("INSERT INTO audit (event, user_id) VALUES (?, ?)", (event, user_id))
+    conn.commit()
