diff --git a/tests/test_queries.py b/tests/test_queries.py
new file mode 100644
--- /dev/null
+++ b/tests/test_queries.py
@@ -0,0 +1,14 @@
+from unittest.mock import MagicMock, patch
+
+from app.catalog import queries
+
+
+def test_get_product_passes_the_id_as_a_parameter():
+    conn = MagicMock()
+    cursor = conn.__enter__.return_value.cursor.return_value
+    cursor.fetchone.return_value = (1, "Mug", 250)
+    with patch.object(queries, "get_connection", return_value=conn):
+        assert queries.get_product(1) == (1, "Mug", 250)
+    cursor.execute.assert_called_once_with(
+        "SELECT id, name, price FROM products WHERE id = %s", (1,)
+    )
