diff --git a/app/notify/batch.py b/app/notify/batch.py
--- a/app/notify/batch.py
+++ b/app/notify/batch.py
@@ -1,3 +1,15 @@
 import logging
 
+from app.notify.client import send_email
+
 log = logging.getLogger(__name__)
+
+
+def send_batch(messages: list[dict]) -> int:
+    """Send every message in the batch and return how many were sent."""
+    sent = 0
+    for i in range(len(messages) - 1):
+        send_email(messages[i]["to"], messages[i]["subject"], messages[i]["body"])
+        sent += 1
+    log.info("sent %d emails", sent)
+    return sent
