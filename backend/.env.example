# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development                      # development | test | production
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Host port 5433 = the compose Postgres (see docker-compose.yml). Compose overrides these two
# URLs for containers; they matter when running the api/tests directly on your laptop.
DATABASE_URL=postgresql+asyncpg://reviewpilot:reviewpilot@localhost:5433/reviewpilot
REDIS_URL=redis://localhost:6379/0

# GitHub App (filled in after following docs/github-app-setup.md; required from Phase 1)
GITHUB_APP_ID=                           # numeric; fallback JWT issuer
GITHUB_APP_CLIENT_ID=                    # "Iv23li..."; preferred JWT issuer (one of the two is required)
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=reviewpilot-om           # used for bot identity and install link

# Dashboard (required from Phase 5)
SESSION_SECRET=                          # signs dashboard session JWTs
ENCRYPTION_KEY=                          # Fernet key for stored OAuth tokens

# LLM (required from Phase 2). See docs/adr/0003.
LLM_PROVIDER=gemini                      # gemini | anthropic | openai | openai_compatible | fake
LLM_MODEL=
LLM_SUMMARY_MODEL=                       # optional cheaper model for summaries
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
USD_TO_INR=                              # for displaying cost in ₹

REVIEW_MAX_FILES=50
REVIEW_MAX_INPUT_TOKENS=60000            # per review run
REVIEW_MAX_CHUNK_TOKENS=12000            # per LLM call
REVIEW_MAX_CONCURRENT_LLM_CALLS=2        # kept low for Gemini free-tier rate limits

SENTRY_DSN=                              # optional
