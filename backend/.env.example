# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development                      # development | test | production
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Host port 5433 = the compose Postgres (see docker-compose.yml). Compose overrides these two
# URLs for containers; they matter when running the api/tests directly on your laptop.
DATABASE_URL=postgresql+asyncpg://reviewpilot:reviewpilot@localhost:5433/reviewpilot
REDIS_URL=redis://localhost:6379/0

# GitHub App (filled in after following docs/github-app-setup.md; required from Phase 1)
GITHUB_APP_ID=                           # numeric; fallback JWT issuer
GITHUB_APP_CLIENT_ID=                    # "Iv23li..."; preferred JWT issuer (one of the two is required)
GITHUB_APP_CLIENT_SECRET=                # required: dashboard login
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=reviewpilot-om           # used for bot identity and install link

# Dashboard login (required). GITHUB_APP_CLIENT_ID / _SECRET above are used for it too.
# SESSION_SECRET: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=                          # signs session cookies (32+ characters)
# ENCRYPTION_KEY: cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=                          # Fernet key for stored GitHub user tokens
SESSION_TTL_DAYS=7
OAUTH_CALLBACK_URL=                      # optional; defaults to APP_BASE_URL/api/v1/auth/github/callback

# LLM: required by the server (the worker reviews PRs) and used by the CLI.
# See docs/adr/0003. Implemented today: gemini, fake (offline, for tests/demos).
LLM_PROVIDER=gemini
LLM_MODEL=                               # a current Gemini model name, see https://ai.google.dev/gemini-api/docs/models
LLM_SUMMARY_MODEL=                       # optional cheaper model for summaries
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
USD_TO_INR=                              # for displaying cost in ₹
# USD per 1M input/output tokens, copied from the provider's pricing page (unknown model = $0, flagged).
# LLM_PRICING={"your-model-name": [0.10, 0.40]}

REVIEW_MAX_FILES=50
REVIEW_MAX_INPUT_TOKENS=60000            # per review run
REVIEW_MAX_CHUNK_TOKENS=12000            # per LLM call
REVIEW_MAX_CONCURRENT_LLM_CALLS=2        # kept low for Gemini free-tier rate limits
REVIEW_MAX_OUTPUT_TOKENS=8192            # per LLM call: a ceiling on what one answer can bill
REVIEW_MAX_COST_USD=                     # optional, per review run; calls that would cross it are skipped
                                         # (only priced models cost anything: see LLM_PRICING)

# Observability (optional). Events are scrubbed: no request bodies, cookies, auth headers,
# query strings or local variables ever leave the server (app/core/observability.py).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0              # 0..1; performance tracing, off by default

# Redis command budget (ADR 0014). Defaults suit local Redis + Flower. On a per-command
# host (Upstash) use 30 / false: an idle worker drops from ~115 to ~5 commands a minute.
CELERY_POLL_SECONDS=1
CELERY_TASK_EVENTS=true
# Production on Render free: the API's health URL; the always-on worker pings it every
# 10 min so the API never sleeps through a webhook. Leave empty locally.
KEEP_WARM_URL=
