# HTTPS for the API: Caddy gets and renews a Let's Encrypt certificate for API_DOMAIN
# by itself (ports 80 and 443 must be open, see docs/deploy.md).
{$API_DOMAIN} {
	encode zstd gzip

	# GitHub webhook payloads can be up to 25 MB; the API enforces the same cap.
	request_body {
		max_size 26MB
	}

	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
