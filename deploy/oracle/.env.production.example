# Copy to deploy/oracle/.env.production ON THE VM and fill in (docs/deploy.md, step 5).
# The real file is git-ignored; never commit it or paste it anywhere.

# Caddy serves the API over HTTPS on this name (your DuckDNS subdomain).
API_DOMAIN=reviewpilot-om.duckdns.org

APP_ENV=production
# The dashboard's public origin (your Vercel URL). The OAuth callback goes through it,
# so the session cookie stays first-party (ADR 0012).
APP_BASE_URL=https://reviewpilot-om.vercel.app
FRONTEND_URL=https://reviewpilot-om.vercel.app

# Neon: the connection string exactly as shown (sslmode/channel_binding are converted).
# Also the job queue (ADR 0016): there is no Redis.
DATABASE_URL=

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=reviewpilot-om

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# A Fernet key, generated on your laptop (docs/deploy.md, step 4). New for production.
ENCRYPTION_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
USD_TO_INR=83
REVIEW_MAX_CONCURRENT_LLM_CALLS=2

# Optional: errors to Sentry (scrubbed; app/core/observability.py).
SENTRY_DSN=
